    <!-- Frontend Interactive Logic Script -->
    <script>
        let cart = [];

        function toggleCart() {
            const drawer = document.getElementById('cart-drawer');
            drawer.classList.toggle('hidden');
        }

        function addToCart(name, price) {
            const existingItem = cart.find(item => item.name === name);
            if (existingItem) {
                existingItem.quantity += 1;
            } else {
                cart.push({ name, price, quantity: 1 });
            }
            updateCartUI();
            toggleCart();
        }

        function updateCartUI() {
            const container = document.getElementById('cart-items-container');
            const badge = document.getElementById('cart-badge');
            const subtotalEl = document.getElementById('cart-subtotal');
            
            let totalCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            let totalPrice = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
            
            badge.textContent = totalCount;
            subtotalEl.textContent = `$${totalPrice.toFixed(2)}`;

            if (cart.length === 0) {
                container.innerHTML = `<p class="text-sm text-gray-500 text-center py-10">Your cart is currently empty.</p>`;
                return;
            }

            container.innerHTML = cart.map((item, index) => `
                <div class="flex items-center justify-between py-3 border-b border-gray-100">
                    <div>
                        <h4 class="font-semibold text-sm text-gray-900">${item.name}</h4>
                        <p class="text-xs text-gray-500">$${item.price.toFixed(2)} &times; ${item.quantity}</p>
                    </div>
                    <button onclick="removeFromCart(${index})" class="text-gray-400 hover:text-red-600 transition text-sm">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            `).join('');
        }

        function removeFromCart(index) {
            cart.splice(index, 1);
            updateCartUI();
        }
    </script>
